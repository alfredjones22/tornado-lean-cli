set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option maxRecDepth 10000
namespace LeanCrypto.Proofs.BabyJubjubCharts
open LeanCrypto.Proofs.BabyJubjub

def numerator_u {R : Type*} [CommRing R] (x y z w : R) : R :=
  168696*w^4*x^3*y^4*z - 506088*w^4*x^3*y^3*z - 113834036448*w^4*x^3*y^2*z^3 + 506088*w^4*x^3*y^2*z + 113835386016*w^4*x^3*y*z^3 - 168696*w^4*x^3*y*z - 337392*w^4*x^2*y^4*z^2 + w^4*x^2*y^4 + 337392*w^4*x^2*y^3*z^2 - 3*w^4*x^2*y^3 - 337388*w^4*x^2*y^2*z^2 + 3*w^4*x^2*y^2 + 337396*w^4*x^2*y*z^2 - w^4*x^2*y + 168696*w^4*x*y^4*z^3 - 2*w^4*x*y^4*z + 168696*w^4*x*y^3*z^3 + 2*w^4*x*y^3*z - 168696*w^4*x*y^2*z^3 + 2*w^4*x*y^2*z - 168696*w^4*x*y*z^3 - 2*w^4*x*y*z + w^4*y^4*z^2 + w^4*y^3*z^2 - w^4*y^2*z^2 - w^4*y*z^2 + 168696*w^3*x^3*y^4*z + 227668072896*w^3*x^3*y^3*z^3 - 674788*w^3*x^3*y^3*z - 113835386016*w^3*x^3*y^2*z^3 + 1012188*w^3*x^3*y^2*z - 1349584*w^3*x^3*y*z^3 - 674796*w^3*x^3*y*z - 113836735600*w^3*x^3*z^3 + 168700*w^3*x^3*z + 337392*w^3*x^2*y^4*z^2 + w^3*x^2*y^4 + 1349568*w^3*x^2*y^3*z^2 - 4*w^3*x^2*y^3 - 1349580*w^3*x^2*y^2*z^2 + 6*w^3*x^2*y^2 - 16*w^3*x^2*y*z^2 - 4*w^3*x^2*y - 337396*w^3*x^2*z^2 + w^3*x^2 - 506088*w^3*x*y^4*z^3 + 2*w^3*x*y^4*z - 674788*w^3*x*y^3*z^3 + 337388*w^3*x*y^2*z^3 - 4*w^3*x*y^2*z + 674788*w^3*x*y*z^3 + 168700*w^3*x*z^3 + 2*w^3*x*z - 3*w^3*y^4*z^2 - 4*w^3*y^3*z^2 + 2*w^3*y^2*z^2 + 4*w^3*y*z^2 + w^3*z^2 - 113834036448*w^2*x^3*y^4*z^3 - 168696*w^2*x^3*y^4*z - 113835386016*w^2*x^3*y^3*z^3 + 337388*w^2*x^3*y^3*z + 2699168*w^2*x^3*y^2*z^3 + 12*w^2*x^3*y^2*z + 113836735600*w^2*x^3*y*z^3 - 337404*w^2*x^3*y*z + 113838085200*w^2*x^3*z^3 + 168700*w^2*x^3*z - 337388*w^2*x^2*y^4*z^2 - w^2*x^2*y^4 - 1349580*w^2*x^2*y^3*z^2 + 2*w^2*x^2*y^3 + 24*w^2*x^2*y^2*z^2 + 1349588*w^2*x^2*y*z^2 - 2*w^2*x^2*y + 337404*w^2*x^2*z^2 + w^2*x^2 + 506088*w^2*x*y^4*z^3 + 2*w^2*x*y^4*z + 1012188*w^2*x*y^3*z^3 - 4*w^2*x*y^3*z + 12*w^2*x*y^2*z^3 - 1012188*w^2*x*y*z^3 + 4*w^2*x*y*z - 506100*w^2*x*z^3 - 2*w^2*x*z + 3*w^2*y^4*z^2 + 6*w^2*y^3*z^2 - 6*w^2*y*z^2 - 3*w^2*z^2 + 113835386016*w*x^3*y^4*z^3 - 168696*w*x^3*y^4*z - 1349584*w*x^3*y^3*z^3 + 674788*w*x^3*y^3*z + 113836735600*w*x^3*y^2*z^3 - 1012188*w*x^3*y^2*z - 227676170400*w*x^3*y*z^3 + 674796*w*x^3*y*z - 168700*w*x^3*z + 337396*w*x^2*y^4*z^2 - w*x^2*y^4 - 16*w*x^2*y^3*z^2 + 4*w*x^2*y^3 + 1349588*w*x^2*y^2*z^2 - 6*w*x^2*y^2 - 1349600*w*x^2*y*z^2 + 4*w*x^2*y - 337400*w*x^2*z^2 - w*x^2 - 168696*w*x*y^4*z^3 - 2*w*x*y^4*z - 674796*w*x*y^3*z^3 - 337404*w*x*y^2*z^3 + 4*w*x*y^2*z + 674796*w*x*y*z^3 + 506100*w*x*z^3 - 2*w*x*z - w*y^4*z^2 - 4*w*y^3*z^2 - 2*w*y^2*z^2 + 4*w*y*z^2 + 3*w*z^2 - 113836735600*x^3*y^3*z^3 + 168700*x^3*y^3*z + 113838085200*x^3*y^2*z^3 - 506100*x^3*y^2*z + 506100*x^3*y*z - 168700*x^3*z - 337396*x^2*y^3*z^2 + x^2*y^3 + 337404*x^2*y^2*z^2 - 3*x^2*y^2 - 337400*x^2*y*z^2 + 3*x^2*y + 337400*x^2*z^2 - x^2 + 168700*x*y^3*z^3 + 2*x*y^3*z + 168700*x*y^2*z^3 - 2*x*y^2*z - 168700*x*y*z^3 - 2*x*y*z - 168700*x*z^3 + 2*x*z + y^3*z^2 + y^2*z^2 - y*z^2 - z^2

def denominator_u {R : Type*} [CommRing R] (x y z w : R) : R :=
  4*x^2*z^2*(-w + y)^2*(w - 1)*(y - 1)*(168696*w*x*y*z - 1)

theorem polynomial_certificate_u {R : Type*} [CommRing R] (x y z w : R) :
    (7114585104 : R)*numerator_u x y z w =
      (-7114585104*w^4*x*y^2*z + 21343755312*w^4*x*y*z + 4800836653157952*w^4*x*z^3 - 28458509112*w^4*x*z + 14229170208*w^4*y^2*z^2 - 42174*w^4*y^2 - 14229170208*w^4*y*z^2 + 126522*w^4*y + 28458509112*w^4*z^2 - 168697*w^4 - 7114585104*w^3*x*y^2*z - 9601673306315904*w^3*x*y*z^3 + 28458509112*w^3*x*y*z + 4800893569838784*w^3*x*z^3 - 49802770512*w^3*x*z - 14229170208*w^3*y^2*z^2 - 42174*w^3*y^2 - 56916680832*w^3*y*z^2 + 168696*w^3*y + 42687679320*w^3*z^2 - 295219*w^3 + 4800836653157952*w^2*x*y^2*z^3 + 7114585104*w^2*x*y^2*z + 4800893569838784*w^2*x*y*z^3 - 14229001512*w^2*x*y*z + 4800836652483168*w^2*x*z^3 + 7114247712*w^2*x*z + 14229001512*w^2*y^2*z^2 + 42174*w^2*y^2 + 56917186920*w^2*y*z^2 - 84348*w^2*y + 14228326724*w^2*z^2 + 42175*w^2 - 4800893569838784*w*x*y^2*z^3 + 7114585104*w*x*y^2*z + 56917355616*w*x*y*z^3 - 28458509112*w*x*y*z - 9601957892419200*w*x*z^3 + 49802770512*w*x*z - 14229338904*w*y^2*z^2 + 42174*w*y^2 + 674784*w*y*z^2 - 168696*w*y - 71147200612*w*z^2 + 295219*w + 4800950487194400*x*y*z^3 - 7114753800*x*y*z - 4801007405224800*x*z^3 + 21344261400*x*z + 14229338904*y*z^2 - 42174*y - 14229676296*z^2 + 126522)*(168700*x^2+y^2-1-168696*x^2*y^2) +
      (-4800893569838784*w^2*x^3*y*z + 4800950487194400*w^2*x^3*z - 28458846504*w^2*x^2*y + 28459183900*w^2*x^2 - 7114585104*w^2*x*y^4*z - 7114585104*w^2*x*y^3*z + 35573094216*w^2*x*y^2*z + 7114585104*w^2*x*y*z - 28458509112*w^2*x*z + 42174*w^2*y^4 - 126522*w^2*y^3 + 126523*w^2*y^2 + 126522*w^2*y - 168697*w^2 - 9601844057033184*w*x^3*y*z + 9601957892419200*w*x^3*z - 56917355616*w*x^2*y + 56918030404*w*x^2 + 21343755312*w*x*y^4*z - 28458509112*w*x*y^3*z + 14229844992*w*x*y^2*z + 28458509112*w*x*y*z - 35573600304*w*x*z + 42174*w*y^4 - 168696*w*y^3 + 253045*w*y^2 + 168696*w*y - 295219*w - 4800950487194400*x^3*y*z + 4801007405224800*x^3*z - 28458509112*x^2*y + 28458846504*x^2 - 21343924008*x*y^3*z + 35573431608*x*y^2*z + 21343924008*x*y*z - 35573431608*x*z - 42174*y^3 + 126522*y^2 + 42174*y - 126522)*(168700*z^2+w^2-1-168696*z^2*w^2) := by
  unfold numerator_u
  ring

theorem numerator_u_zero (x y z w : Field)
    (first : Edwards x y) (second : Edwards z w) : numerator_u x y z w = 0 := by
  have firstZero : 168700*x^2+y^2-1-168696*x^2*y^2 = 0 := by
    calc
      _ = (168700*x^2+y^2)-(1+168696*x^2*y^2) := by ring
      _ = 0 := sub_eq_zero.mpr first
  have secondZero : 168700*z^2+w^2-1-168696*z^2*w^2 = 0 := by
    calc
      _ = (168700*z^2+w^2)-(1+168696*z^2*w^2) := by ring
      _ = 0 := sub_eq_zero.mpr second
  have certificate := polynomial_certificate_u x y z w
  rw [firstZero, secondZero, mul_zero, mul_zero, add_zero] at certificate
  exact (mul_eq_zero.mp certificate).resolve_left (by decide +kernel)

end LeanCrypto.Proofs.BabyJubjubCharts
