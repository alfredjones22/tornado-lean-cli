import Tornado.Crypto.TornadoSignature
import Tornado.Crypto.MiMCTree
import Tornado.Protocol.Groth16R1CS

/-!
The native input boundary for the pinned Classic Tornado `Withdraw(20)`
Circom circuit. Signal slots 0..48 are the constant, six public inputs, and
42 private inputs. The remaining 28,251 witness slots are generated by the
39 Circom templates; this module deliberately does not fabricate them.

The note identifiers and Merkle path are recomputed in Lean before they are
placed in the input prefix. The expected root must be supplied by a separate,
trusted pool-history check at the call site.
-/

namespace Tornado.Protocol.TornadoWitness

open Tornado.Crypto
open Tornado.Protocol.Groth16R1CS

structure WithdrawalInput where
  note : TornadoSignatureNote
  proof : MimcProof
  expectedRoot : Nat
  recipient : Nat
  relayer : Nat
  fee : Nat
  refund : Nat

/-- Slot layout from `signalName2Idx` in the pinned circuit JSON. The
    `nullifier` and `secret` fields use Circom's little-endian bit order. -/
def inputPrefix (input : WithdrawalInput) : Array Nat :=
  #[1, input.proof.root, input.note.nullifierHash,
    input.recipient, input.relayer, input.fee, input.refund,
    input.note.nullifier, input.note.secret] ++
    input.proof.siblings ++ input.proof.pathIndices

theorem inputPrefix_size (input : WithdrawalInput)
    (hs : input.proof.siblings.size = 20)
    (hd : input.proof.pathIndices.size = 20) :
    (inputPrefix input).size = 49 := by
  simp [inputPrefix, hs, hd]

theorem inputPrefix_public_root (input : WithdrawalInput) :
    (inputPrefix input)[1]? = some input.proof.root := by
  simp [inputPrefix, Array.getElem?_append]

theorem inputPrefix_nullifier_hash (input : WithdrawalInput) :
    (inputPrefix input)[2]? = some input.note.nullifierHash := by
  simp [inputPrefix, Array.getElem?_append]

theorem inputPrefix_private_nullifier (input : WithdrawalInput) :
    (inputPrefix input)[7]? = some input.note.nullifier := by
  simp [inputPrefix, Array.getElem?_append]

/-- Check all values before exposing a witness input prefix. This is a
    native Lean computation and makes no call to the JavaScript witness
    interpreter. It is not a complete R1CS witness. -/
def prepareInputPrefix (input : WithdrawalInput) : Except String (Array Nat) := do
  if input.note.nullifierBytes.size != 31 || input.note.secretBytes.size != 31 then
    throw "Tornado nullifier and secret must each contain 31 bytes."
  if input.proof.siblings.size != 20 || input.proof.pathIndices.size != 20 then
    throw "Tornado withdrawal requires a 20-level Merkle path."
  if input.expectedRoot >= scalarPrime || input.proof.root != input.expectedRoot then
    throw "Merkle path root does not match the expected pool root."
  if input.recipient >= 2 ^ 160 || input.relayer >= 2 ^ 160 then
    throw "Tornado recipient or relayer exceeds an Ethereum address."
  if input.fee >= scalarPrime || input.refund >= scalarPrime then
    throw "Tornado fee or refund exceeds the circuit field."
  if input.proof.siblings.any (· >= scalarPrime) then
    throw "Merkle sibling exceeds the circuit field."
  let commitment ← pedersenX input.note.preimage
  if commitment != input.note.commitment then
    throw "Tornado note commitment does not match its secret preimage."
  let nullifierHash ← pedersenX input.note.nullifierBytes
  if nullifierHash != input.note.nullifierHash then
    throw "Tornado nullifier hash does not match its preimage."
  if !(← verifyMimcProof input.note.commitment input.proof) then
    throw "Tornado note is not a member of the expected Merkle root."
  return inputPrefix input

end Tornado.Protocol.TornadoWitness

#print axioms Tornado.Protocol.TornadoWitness.inputPrefix_size
#print axioms Tornado.Protocol.TornadoWitness.inputPrefix_public_root
#print axioms Tornado.Protocol.TornadoWitness.inputPrefix_nullifier_hash
#print axioms Tornado.Protocol.TornadoWitness.inputPrefix_private_nullifier
